# systemd unit for BEThoven. Install on the VM at:
#   /etc/systemd/system/bethoven.service
# then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bethoven
#
# Runs as an unprivileged user. Binary, DB, host key, and fixtures live under
# /opt/bethoven (a persistent disk). Edit Environment= lines to taste.

[Unit]
Description=BEThoven — World Cup prediction pool over SSH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bethoven
Group=bethoven
WorkingDirectory=/opt/bethoven
ExecStart=/opt/bethoven/bethoven
Restart=on-failure
RestartSec=3

Environment=BETHOVEN_PORT=2222
Environment=BETHOVEN_DB_PATH=/opt/bethoven/data/bethoven.db
Environment=BETHOVEN_HOST_KEY_PATH=/opt/bethoven/data/host_key
# Change this before launch and share it with the team:
Environment=BETHOVEN_INVITE_CODE=change-me
# Comma-separated SHA256 fingerprints (from `ssh-keygen -lf your_key.pub`):
Environment=BETHOVEN_ADMINS=SHA256:REPLACE_WITH_YOUR_FINGERPRINT

# Automatic results (football-data.org). The API key is a SECRET, so it does NOT
# live here — keep it in a root-owned 600 file the unit loads at start:
#   sudo install -m 600 /dev/null /opt/bethoven/data/secrets.env
#   echo 'BETHOVEN_RESULTS_API_KEY=your-token' | sudo tee /opt/bethoven/data/secrets.env
# The leading "-" means the unit still starts if the file is absent (results then
# just stay off, with a warning in the log).
Environment=BETHOVEN_RESULTS_ENABLED=true
Environment=BETHOVEN_RESULTS_COMPETITION=WC
Environment=BETHOVEN_RESULTS_INTERVAL=5m
EnvironmentFile=-/opt/bethoven/data/secrets.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bethoven/data

[Install]
WantedBy=multi-user.target
